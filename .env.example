# Chat 对话记录导出工具 - 环境变量配置
# 复制此文件为 .env 或 .env.local，然后填入你的值

# ==================== DeepSeek（HTTP 重放）====================
# F12 → Network → 找发往 chat.deepseek.com 的请求
DEEPSEEK_COOKIE="your_cookie_here"
DEEPSEEK_BEARER_TOKEN="your_bearer_token_here"

# ==================== ChatGPT（HTTP 重放）====================
# 需要 socks5 代理穿透 Cloudflare + Bearer Token
# Token 获取：F12 → Network → /api/auth/session 响应里的 accessToken
CHATGPT_BEARER_TOKEN="your_chatgpt_access_token_here"
# 本机 socks 代理（ChatGPT 必须，否则 403）
CHATGPT_SOCKS_PROXY="socks5://127.0.0.1:7890"

# ==================== 千问 Qwen（推荐浏览器引擎）====================
# 浏览器引擎（--engine browser）无需凭证，打开浏览器登录即可。
# HTTP 重放需要 ut（URL 里的 UC 令牌）+ Cookie：
# F12 → Network → 找 chat2-api.qianwen.com 请求
QWEN_COOKIE="your_qianwen_cookie_here"
QWEN_UT="your_qianwen_ut_token_here"

# ==================== 豆包 Doubao（浏览器引擎）====================
# 认证依赖 HttpOnly Cookie，纯 HTTP 无法重放，必须用 --engine browser
# DOUBAO_COOKIE 留空即可

# ==================== Grok（浏览器引擎）====================
# 认证依赖 HttpOnly Cookie，纯 HTTP 无法重放，必须用 --engine browser
# GROK_COOKIE 留空即可

# ==================== 通用 ====================
# 可选：默认输出目录（不设置时为 ./{platform}_chats，如 ./deepseek_chats）
# OUTPUT_DIR="./chat_exports"

# 可选：默认导出日期（YYYY-MM-DD，不设置时导出今天；命令行 --date 优先）
# EXPORT_DATE="2026-05-30"
